# =============================================================================================
# NovaTech Hiring Automation - environment configuration
# Copy to .env (or run scripts/new-env.ps1 / scripts/new-env.sh to generate strong secrets).
# NEVER commit .env. Use only URL-safe characters (A-Z a-z 0-9) in passwords.
# =============================================================================================

# ---- General ---------------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
COMPANY_TIMEZONE=Asia/Karachi

# ---- Business database (PostgreSQL) ------------------------------------------------------------
BUSINESS_DB_PORT=5433               # host port (localhost only)
POSTGRES_SUPERUSER_PASSWORD=change-me
NOVATECH_OWNER_PASSWORD=change-me   # migrations / seeds
NOVATECH_N8N_DB_PASSWORD=change-me  # n8n runtime role (use in the n8n Postgres credential)
NOVATECH_BACKEND_DB_PASSWORD=change-me

# Demo configuration
SEED_DEMO_DATA=true                 # load NovaTech positions, scoring rules, staff and interview slots
DEMO_FAST_TIMERS=false              # true = reminders/expiries in minutes instead of days (demo only)

# ---- n8n -------------------------------------------------------------------------------------
N8N_VERSION=2.40.7
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me        # back this up; losing it makes stored credentials unreadable
N8N_RUNNERS_AUTH_TOKEN=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false             # true when served over HTTPS
N8N_LOG_LEVEL=info

# ---- Backend API -------------------------------------------------------------------------------
BACKEND_PORT=8000
# Comma-separated keys accepted in the X-API-Key header (n8n -> backend). Two keys allow rotation.
INTERNAL_API_KEYS=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173
EXPOSE_API_DOCS=true
MAX_UPLOAD_MB=5
DEFAULT_PHONE_REGION=PK
# Signs the links in emails (interview slot, offer response, interviewer feedback, offer approval).
# Required in production (>= 32 chars). Rotating it invalidates links that were already sent.
LINK_SIGNING_SECRET=change-me
LINK_MAX_TTL_DAYS=30
# Dev/test only: honour X-Fault-Inject headers to demonstrate failure handling. Forced off in production.
FAULT_INJECTION_ENABLED=true

# ---- AI (advisory candidate analysis) ------------------------------------------------------------
# Provider: anthropic | openai | mistral | google | none   (none = AI disabled, screening uses rules only)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=16000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=

# Langfuse tracing (optional; leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
