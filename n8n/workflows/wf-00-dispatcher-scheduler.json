          "queryReplacement": "={{ (() => { const a = $(\"Loop Actions\").first().json; const failedHard = $json.error !== undefined; const outcome = failedHard ? \"FAILED\" : ($json.action_outcome || \"DONE\"); const reason = failedHard ? String($json.error?.message ?? $json.error) : ($json.action_reason || \"\"); return [ a.id, outcome, JSON.stringify({ reason }), outcome === \"FAILED\" ? reason : \"\", JSON.stringify({ ...$(\"Build Context\").first().json.ctx, correlation_id: a.correlation_id, retry_count: a.attempts }) ]; })() }}"
        }
