    {
      "id": "2e226710-87da-55ca-a397-ba10a9cf09df",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -540,
        180
      ],
      "parameters": {
        "content": "## SWF-03 Fail & Record Error\nCalled by any workflow on an unrecoverable failure.\n1. `api.record_error` stores the error with the original payload and the replay target (deduplicated by fingerprint).\n2. `api.finish_workflow_execution` marks the calling execution FAILED.\n\nOperators see it in the HR portal (**Automation errors**, from `reporting.v_error_queue`) and replay it through WF-07.",
        "width": 680,
        "height": 260,
        "color": 5
      }
    }
  ],
