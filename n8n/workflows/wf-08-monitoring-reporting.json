      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT api.start_workflow_execution($1::jsonb, 'SUB_WORKFLOW', 'APPLICATION', $2) AS run_id,\n       api.application_snapshot($2::uuid) AS app,\n       (SELECT string_agg(s.email, ',' ORDER BY s.email) FROM hiring.staff_members s\n         WHERE s.is_active AND s.roles && ARRAY['RECRUITER', 'HR_ADMIN']) AS recruiters,\n       (SELECT s.email FROM hiring.applications a\n          JOIN hiring.job_positions p ON p.id = a.job_position_id\n          JOIN hiring.staff_members s ON s.id = p.hiring_manager_id\n         WHERE a.id = $2::uuid AND s.is_active) AS hiring_manager_email,\n       (SELECT value #>> '{}' FROM hiring.settings WHERE key = 'company.portal_url') AS portal_url",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.ctx), $json.application_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ntPostgresApp001",
          "name": "NovaTech DB (n8n_app)"
        }
