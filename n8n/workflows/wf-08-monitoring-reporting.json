        "assignments": {
          "assignments": [
            {
              "id": "fd454d2a-bc5d-5f6c-ad28-cdc827160e8e",
              "name": "summary",
              "value": "={{ $json.ok ? $json.body.summary : \"The summary service was unavailable; the figures below come directly from the database.\" }}",
              "type": "string"
            },
            {
              "id": "7e1f4b59-069c-5f5e-acfd-f44e6741beb5",
              "name": "summary_source",
              "value": "={{ $json.ok ? $json.body.summary_source : \"TEMPLATE\" }}",
              "type": "string"
            },
            {
              "id": "d5cfd45b-5c82-58e7-a8fd-497bc07a5d9e",
              "name": "subject",
              "value": "={{ \"Daily hiring report \" + $(\"Load Metrics\").first().json.report_date + \" - \" + ($(\"Load Metrics\").first().json.company || \"NovaTech\") }}",
              "type": "string"
            },
            {
              "id": "37407384-5b16-5a25-a784-a8683184edf9",
              "name": "html",
              "value": "={{ (() => { const esc = s => String(s ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c]); const layout = (body, footer) => \"<div style='font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.55;color:#1d2939;max-width:640px'>\" + body + \"<p style='margin-top:24px;color:#667085;font-size:12px'>\" + (footer || \"NovaTech Solutions\") + \"</p></div>\"; const m = $(\"Load Metrics\").first().json.metrics || {}; const label = k => k.replace(/_/g, \" \").replace(/^./, c => c.toUpperCase()); const sections = $json.ok ? $json.body.sections : [{ title: \"Metrics\", rows: Object.keys(m).filter(k => typeof m[k] === \"number\").sort().map(k => ({ label: label(k), value: m[k] })) }]; const table = sections.map(s => \"<h3 style='margin:18px 0 6px'>\" + esc(s.title) + \"</h3><table cellpadding='6' style='border-collapse:collapse;border:1px solid #d0d5dd'>\" + s.rows.map(r => \"<tr><td style='border:1px solid #d0d5dd'>\" + esc(r.label) + \"</td><td style='border:1px solid #d0d5dd;text-align:right'><b>\" + esc(r.value ?? \"-\") + \"</b></td></tr>\").join(\"\") + \"</table>\").join(\"\"); return layout(\"<h2 style='margin:0 0 8px'>Daily hiring report, \" + esc($(\"Load Metrics\").first().json.report_date) + \"</h2><p>\" + esc($json.ok ? $json.body.summary : \"The summary service was unavailable; the figures below come directly from the database.\") + \"</p>\" + table, \"All figures are computed by the database (reporting.daily_metrics). Summary: \" + esc($json.ok ? $json.body.summary_source : \"TEMPLATE\") + \".\"); })() }}",
              "type": "string"
            }
          ]
        }
      }
    },
