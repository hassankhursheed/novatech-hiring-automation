    {
      "id": "a417cbb6-7a60-5a17-af17-49ed6c89a7f0",
      "name": "Load Metrics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1020,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (\n  SELECT coalesce(NULLIF($2, '')::date,\n                  (now() AT TIME ZONE (SELECT value #>> '{}' FROM hiring.settings WHERE key = 'company.timezone'))::date - 1) AS report_date)\nSELECT d.report_date::text AS report_date,\n       api.start_workflow_execution($1::jsonb, $3, 'REPORT', d.report_date::text) AS run_id,\n       reporting.daily_metrics(d.report_date) AS metrics,\n       r.delivered_at,\n       coalesce((SELECT string_agg(s.email, ',' ORDER BY s.email) FROM hiring.staff_members s\n                  WHERE s.is_active AND s.roles && ARRAY['HR_ADMIN', 'APPROVER_L2']),\n                (SELECT value #>> '{}' FROM hiring.settings WHERE key = 'ops.alert_email')) AS recipients,\n       (SELECT value #>> '{}' FROM hiring.settings WHERE key = 'company.name') AS company\n  FROM d LEFT JOIN ops.daily_reports r ON r.report_date = d.report_date",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.ctx), $json.report_date, $json.trigger_type ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ntPostgresApp001",
          "name": "NovaTech DB (n8n_app)"
        }
      }
    },
