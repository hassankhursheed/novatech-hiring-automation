              "type": "object"
            },
            {
              "id": "attempts",
              "name": "attempts",
              "value": 1,
              "type": "number"
            },
            {
              "id": "eclass",
              "name": "error_class",
              "value": "={{ (() => { const s = $json.statusCode; if (s >= 200 && s < 300) return \"\"; if (!s) return \"RETRYABLE\"; const r = $json.body?.retryable; if (typeof r === \"boolean\") return r ? \"RETRYABLE\" : \"NON_RETRYABLE\"; return (s === 429 || s === 408 || s >= 500) ? \"RETRYABLE\" : \"NON_RETRYABLE\"; })() }}",
              "type": "string"
            },
            {
              "id": "ecode",
              "name": "error_code",
              "value": "={{ ($json.statusCode >= 200 && $json.statusCode < 300) ? \"\" : ($json.body?.code ?? ($json.statusCode ? \"HTTP_\" + $json.statusCode : \"NETWORK_ERROR\")) }}",
