    {
      "id": "0fe38e66-df97-4c0a-be29-9e1bb63589a4",
      "name": "Compose Candidate Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1300,
        160
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "recipient",
              "name": "recipient",
              "value": "={{ $(\"Build Context\").item.json.validation?.application?.email || \"\" }}",
              "type": "string"
            },
            {
              "id": "template",
              "name": "template_key",
              "value": "={{ ({ ACCEPTED: \"application.received\", NEEDS_REVIEW: \"application.received\", DUPLICATE: \"application.duplicate\", INVALID: \"application.invalid\" })[$json.outcome] || \"application.received\" }}",
              "type": "string"
            },
            {
              "id": "dedupe",
              "name": "dedupe_key",
              "value": "={{ \"candidate.ack:\" + $(\"Build Context\").item.json.event_id }}",
              "type": "string"
            },
            {
              "id": "subject",
              "name": "subject",
              "value": "={{ (() => { const p = $(\"Build Context\").item.json.validation?.application?.position_title || \"your application\"; const o = $json.outcome; if (o === \"DUPLICATE\") return \"We already have your application for \" + p; if (o === \"INVALID\") return \"We could not process your application\"; return \"We received your application for \" + p; })() }}",
              "type": "string"
            },
            {
              "id": "html",
              "name": "html",
              "value": "={{ (() => { const esc = s => String(s ?? \"\").replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", \"\\\"\": \"&quot;\" })[c]); const a = $(\"Build Context\").item.json.validation?.application || {}; const name = esc(a.full_name || \"Applicant\"); const pos = esc(a.position_title || \"the position\"); const code = esc($json.application_code || \"\"); const o = $json.outcome; let body; if (o === \"DUPLICATE\") { body = \"<p>We already have an active application from you for <b>\" + pos + \"</b> (reference \" + code + \"). There is no need to apply again; we will update you on the existing application.</p>\"; } else if (o === \"INVALID\") { body = \"<p>Unfortunately we could not process your application: \" + esc($json.reason || \"some required information was missing\") + \".</p><p>Please submit the form again with the missing details.</p>\"; } else { body = \"<p>Thank you for applying for <b>\" + pos + \"</b> at NovaTech Solutions. Your reference number is <b>\" + code + \"</b>.</p><p>Our team will review your application and contact you about the next steps.</p>\"; } return \"<p>Dear \" + name + \",</p>\" + body + \"<p>Kind regards,<br/>NovaTech Talent Team</p>\"; })() }}",
              "type": "string"
            },
            {
              "id": "appid",
              "name": "application_id",
              "value": "={{ $json.application_id || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
