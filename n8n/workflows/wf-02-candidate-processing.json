              "value": "={{ ({ actor_type: \"SYSTEM\", actor_id: \"n8n\", workflow_name: \"WF-02\", workflow_version: \"1.0.0\", execution_id: $execution.id, correlation_id: $json.correlation_id || $json.action?.correlation_id || null }) }}",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "18f77a6f-1c0e-4245-9045-479a0cdb6fdc",
      "name": "Intake or Action?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        640,
        400
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "intake",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mode }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "intake"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "rejection notice",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action?.action_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "SEND_REJECTION_NOTICE"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
